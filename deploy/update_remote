#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/remote_common.sh"

remote_root <<'REMOTE'
test -x /opt/cat-tracker/.venv/bin/python || { echo 'Run install_remote and setup_infra_remote first.' >&2; exit 1; }
REMOTE
copy_project
remote_root <<'REMOTE'
/opt/cat-tracker/.venv/bin/python -m pip install --upgrade /opt/cat-tracker
install -m 0644 /opt/cat-tracker/deploy/cat-tracker.service /etc/systemd/system/cat-tracker.service
install -m 0644 /opt/cat-tracker/deploy/90-cat-tracker-bluetooth.conf /etc/dbus-1/system.d/90-cat-tracker-bluetooth.conf
systemctl reload dbus
systemctl daemon-reload
REMOTE
echo 'Updated application files. Run restart_remote to load the new version.'
