#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/remote_common.sh"

remote_root <<'REMOTE'
test -x /usr/bin/node || { echo 'Run install_remote and setup_infra_remote first.' >&2; exit 1; }
REMOTE
copy_project
remote_root <<'REMOTE'
cd /opt/cat-tracker
node -e "if (Number(process.versions.node.split('.')[0]) !== 24) process.exit(1)"
npm ci
npm run build
install -m 0644 /opt/cat-tracker/deploy/cat-tracker.service /etc/systemd/system/cat-tracker.service
systemctl daemon-reload
REMOTE
echo 'Updated application files. Run restart_remote to load the new version.'
