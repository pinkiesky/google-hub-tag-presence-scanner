#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/remote_common.sh"

remote_root <<'REMOTE'
test -f /opt/cat-tracker/package.json || { echo 'Run install_remote first.' >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y python3 build-essential bluez libbluetooth-dev libudev-dev libusb-1.0-0-dev pkg-config libcap2-bin sqlite3 rsync
test -x /usr/bin/node || { echo 'Install Node.js 24 LTS at /usr/bin/node first.' >&2; exit 1; }
/usr/bin/node -e "if (Number(process.versions.node.split('.')[0]) !== 24) process.exit(1)"
groupadd --system --force bluetooth
if ! id cat-tracker >/dev/null 2>&1; then
    useradd --system --user-group --home-dir /var/lib/cat-tracker \
        --no-create-home --shell /usr/sbin/nologin cat-tracker
fi
usermod -aG bluetooth cat-tracker
install -d -o root -g cat-tracker -m 0750 /etc/cat-tracker
install -d -o cat-tracker -g cat-tracker -m 0700 /var/lib/cat-tracker
if [[ ! -e /etc/cat-tracker/config.json ]]; then
    install -o root -g cat-tracker -m 0640 /opt/cat-tracker/config.example.json /etc/cat-tracker/config.json
fi
if [[ ! -e /etc/cat-tracker/telegram.env ]]; then
    install -o root -g root -m 0600 /opt/cat-tracker/.env.example /etc/cat-tracker/telegram.env
fi
cd /opt/cat-tracker
npm ci
npm run build
npm test
npm run lint
install -m 0644 /opt/cat-tracker/deploy/cat-tracker.service /etc/systemd/system/cat-tracker.service
systemctl daemon-reload
systemctl enable --now bluetooth
bluetoothctl power on
systemctl enable cat-tracker
REMOTE
echo 'Infrastructure ready. Add tag secrets and Telegram credentials, then run restart_remote.'
