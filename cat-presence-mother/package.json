{
  "name": "cat-presence-mother",
  "version": "2.0.0",
  "private": true,
  "description": "Cat presence aggregation over HTTP and UDP",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build && node scripts/copy-assets.cjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit -p tsconfig.json && eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@noble/curves": "^2.0.0",
    "better-sqlite3": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fs-ext": "^2.1.1",
    "prom-client": "^15.1.3",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@prettier/plugin-pug": "^3.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/fs-ext": "^2.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.8",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "fs-ext@2.1.1": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
