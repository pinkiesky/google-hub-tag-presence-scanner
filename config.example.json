{
  "service": {
    "alert_after_seconds": 3600,
    "startup_grace_seconds": 120,
    "watchdog_interval_seconds": 30,
    "missing_after_seconds": 60,
    "drift_windows": 16,
    "scanner_cycle_seconds": 300,
    "adapter": "hci0",
    "database": "/var/lib/cat-tracker/presence.sqlite3"
  },
  "tags": [
    { "id": "cat-a", "secret_file": "/etc/cat-tracker/cat-a.json", "clock_offset_seconds": 0 },
    { "id": "cat-b", "secret_file": "/etc/cat-tracker/cat-b.json", "clock_offset_seconds": 0 }
  ]
}
