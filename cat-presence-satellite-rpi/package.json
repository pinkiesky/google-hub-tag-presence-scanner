{
  "name": "cat-presence-satellite-rpi",
  "version": "1.0.0",
  "private": true,
  "description": "BLE observation forwarding over HTTP",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "debug": "node dist/debug.js",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json && eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@stoprocent/noble": "^2.3.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "@types/lodash": "^4.17.25"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@serialport/bindings-cpp@12.0.1": true,
    "@stoprocent/bluetooth-hci-socket@2.3.0": true,
    "@stoprocent/noble@2.8.0": true,
    "unrs-resolver@1.12.2": true,
    "usb@2.18.0": true
  }
}
