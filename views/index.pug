doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Cat tracker
    link(rel='stylesheet', href='/style.css')
  body
    h1 Cat tracker
    .table
      table
        thead
          tr
            th Cat
            th Status
            th Signal
        tbody
          each tag in tags
            tr
              th(scope='row')= tag.name
              td= tag.present ? 'Present' : 'Not present'
              td= tag.signalDbm === null ? '—' : `${tag.signalDbm} dBm`
